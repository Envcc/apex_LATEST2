rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    /**
     * Engagements & Mandates Collection: Immutable Funding & Isolation
     */
    match /engagements/{engagementId} {
      allow read, write: if isAuthenticated();
    }

    match /mandates/{mandateId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() 
        && request.resource.data.escrowStatus == 'UNFUNDED'
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuthenticated() 
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.escrowStatus == resource.data.escrowStatus; // State lock: Prevent client-side escrow tampering
    }

    /**
     * Atomic Operational Units (AOUs)
     */
    match /mandates/{mandateId}/aous/{aouId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    /**
     * Verifiable Proof Vault: Immutable Attestation Store
     */
    match /proofs/{proofId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); // Allowed for client attestation pings in dev sandbox; Admin SDK in production
    }

    /**
     * User Profiles
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId);
    }
  }
}
