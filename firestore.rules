rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validation ---
    
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role'])
        && data.uid == request.auth.uid
        && data.role in ['CLIENT', 'BUREAU', 'ADMIN']
        && data.email is string;
    }

    function isValidEngagement(data) {
      return data.keys().hasAll(['clientId', 'title', 'objective', 'status'])
        && data.clientId == request.auth.uid
        && data.status in ['DRAFT', 'SCOPING', 'PRICED', 'FUNDED', 'IN_PROGRESS', 'VERIFYING', 'COMPLETED', 'DISPUTED']
        && data.title is string && data.title.size() <= 200;
    }

    function isValidAOU(data) {
      return data.keys().hasAll(['engagementId', 'title', 'status'])
        && data.status in ['PENDING', 'READY', 'IN_PROGRESS', 'VERIFYING', 'COMPLETED', 'FAILED']
        && data.title is string && data.title.size() <= 200;
    }

    // --- Rules ---

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUser(incoming());
    }

    match /engagements/{engagementId} {
      allow list: if isSignedIn() && resource.data.clientId == request.auth.uid;
      allow get: if isSignedIn() && (resource.data.clientId == request.auth.uid || resource.data.bureauId == request.auth.uid);
      allow create: if isSignedIn() && isValidEngagement(incoming());
      allow update: if isSignedIn() && (
        // Client can update status to FUNDED or IN_PROGRESS
        (isOwner(existing().clientId) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) && incoming().status in ['FUNDED', 'IN_PROGRESS'])
        || (isOwner(existing().clientId) && isValidEngagement(incoming()))
      );
    }

    match /engagements/{engagementId}/aous/{aouId} {
      allow list, get: if isSignedIn();
      allow create, update: if isSignedIn();
    }

    match /engagements/{engagementId}/milestones/{milestoneId} {
      allow list, get: if isSignedIn();
      allow create, update: if isSignedIn();
    }
  }
}
