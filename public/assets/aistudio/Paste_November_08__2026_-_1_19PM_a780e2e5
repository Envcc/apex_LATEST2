3.2 Box-Muller Transformation EngineTypeScript// src/lib/simulation-engine.ts
export interface RiskParams {
  baseCost: number;
  complexityMultiplier: number;
  iterations?: number;
}

export interface RiskMatrixResult {
  p50Cost: number;
  p80Cost: number;
  p90Cost: number;
  p99TailRisk: number;
  variance: number;
  rawDistribution: number[];
}

export function executeFatTailedMonteCarlo(params: RiskParams): RiskMatrixResult {
  const iterations = params.iterations || 1000;
  const { baseCost, complexityMultiplier } = params;
  const results = new Float64Array(iterations);

  const sigma = 0.22 * Math.max(1.0, complexityMultiplier);
  const mu = Math.log(baseCost) - 0.5 * Math.pow(sigma, 2);

  for (let i = 0; i < iterations; i++) {
    let u1 = 0;
    let u2 = 0;
    while (u1 === 0) u1 = Math.random();
    while (u2 === 0) u2 = Math.random();

    // Box-Muller Transform for standard normal variate Z ~ N(0,1)
    const z = Math.sqrt(-2.0 * Math.log(u1)) * Math.cos(2.0 * Math.PI * u2);

    // Log-Normal Transformation
    results[i] = Math.exp(mu + sigma * z);
  }

  // Sort samples in ascending numeric order
  const sorted = Array.from(results).sort((a, b) => a - b);

  const mean = sorted.reduce((acc, v) => acc + v, 0) / iterations;
  const variance = sorted.reduce((acc, v) => acc + Math.pow(v - mean, 2), 0) / iterations;

  return {
    p50Cost: Number(sorted[Math.floor(iterations * 0.50)].toFixed(2)),
    p80Cost: Number(sorted[Math.floor(iterations * 0.80)].toFixed(2)),
    p90Cost: Number(sorted[Math.floor(iterations * 0.90)].toFixed(2)),
    p99TailRisk: Number(sorted[Math.floor(iterations * 0.99)].toFixed(2)),
    variance: Number(variance.toFixed(2)),
    rawDistribution: sorted
  };
}
