import express from 'express';
import { GoogleGenerativeAI } from '@google/genai';
import { configureSecurityMiddleware } from './src/lib/security-config';
import { verifyStrictBearerAuth, AuthenticatedRequest } from './server/middleware/auth-hardened';
import { parseAndValidateCandidateAST } from './src/lib/ast-compiler';
import { assertValidAOUDAG } from './src/lib/dag-validator';
import { MultithreadedSimulationPool } from './server/worker-pool';
import { persistMandateTransaction } from './src/lib/firestore-mutator';

const app = express();
app.use(express.json());
configureSecurityMiddleware(app);

const ai = new GoogleGenerativeAI(process.env.GEMINI_API_KEY || '');
const simulationPool = new MultithreadedSimulationPool();

// Ingress Endpoint 1: Natural Language Directive to Validated AST
app.post('/api/scope', verifyStrictBearerAuth, async (req: AuthenticatedRequest, res: express.Response) => {
  try {
    const { targetOutcome } = req.body;
    if (!targetOutcome) {
      return res.status(400).json({ error: 'Directive payload parameter [targetOutcome] is required.' });
    }

    const model = ai.getGenerativeModel({
      model: 'gemini-1.5-flash',
      generationConfig: { responseMimeType: 'application/json' }
    });

    const prompt = `Decompose this enterprise target outcome directive into 4 to 6 Atomic Operational Units (AOUs).
    Target Directive: "${targetOutcome}"
    Output JSON schema matching AST specification with UUIDs for ids and dependsOn arrays.`;

    const response = await model.generateContent(prompt);
    const rawText = response.response.text();

    // 1. Token Sanitization & Zod Invariant Check
    const ast = parseAndValidateCandidateAST(rawText);

    // 2. Formal DFS DAG Cycle Validation
    assertValidAOUDAG(ast);

    return res.status(200).json({ success: true, ast });
  } catch (err: any) {
    return res.status(422).json({ error: 'AST Compilation Failure', details: err.message });
  }
});

// Ingress Endpoint 2: Multithreaded Monte Carlo Underwriting
app.post('/api/cost', verifyStrictBearerAuth, async (req: AuthenticatedRequest, res: express.Response) => {
  try {
    const { baseCost, complexityMultiplier } = req.body;

    const riskMatrix = await simulationPool.runSimulation({
      baseCost: Number(baseCost) || 50000,
      complexityMultiplier: Number(complexityMultiplier) || 1.0
    });

    return res.status(200).json({ success: true, riskMatrix });
  } catch (err: any) {
    return res.status(500).json({ error: 'Simulation Engine Execution Failure', details: err.message });
  }
});

// Ingress Endpoint 3: Lock Escrow and Persist Mandate to Cloud Firestore
app.post('/api/mandates/lock', verifyStrictBearerAuth, async (req: AuthenticatedRequest, res: express.Response) => {
  try {
    const { ast, allocatedP90Capital } = req.body;
    const userId = req.user?.uid || 'anonymous-user';

    const mandateId = await persistMandateTransaction(userId, ast, allocatedP90Capital);
    return res.status(200).json({ success: true, mandateId, status: 'LOCKED' });
  } catch (err: any) {
    return res.status(500).json({ error: 'Mandate Persistence Transaction Failed', details: err.message });
  }
});

const PORT = process.env.PORT || 8080;
app.listen(PORT, () => {
  console.log(`[SYS_KERNEL_INIT] Apex Bureau Production Platform listening on port ${PORT}`);
});
