6.2 Atomic Write Transactions & State Isolation RulesTypeScript// src/lib/firestore-mutator.ts
import { dbAdmin } from './firebase-admin';
import { MandateAST } from './ast-ir-spec';

export async function persistMandateTransaction(
  userId: string,
  ast: MandateAST,
  p90Capital: number
): Promise<string> {
  const mandateRef = dbAdmin.collection('mandates').doc();
  const batch = dbAdmin.batch();

  batch.set(mandateRef, {
    targetDirective: ast.targetDirective,
    escrowStatus: 'UNFUNDED',
    allocatedP90Capital: p90Capital,
    createdBy: userId,
    createdAt: new Date().toISOString()
  });

  for (const unit of ast.units) {
    const unitRef = mandateRef.collection('units').doc(unit.id);
    batch.set(unitRef, {
      title: unit.title,
      description: unit.description,
      dependsOn: unit.dependsOn,
      estimatedHours: unit.estimatedHours,
      complexityScalar: unit.complexityScalar
    });

    for (const criterion of unit.exitCriteria) {
      const critRef = unitRef.collection('exitCriteria').doc(criterion.id);
      batch.set(critRef, {
        type: criterion.type,
        assertionEndpoint: criterion.assertionEndpoint,
        expectedStatusCode: criterion.expectedStatusCode,
        expectedPayloadHash: criterion.expectedPayloadHash
      });
    }
  }

  await batch.commit();
  return mandateRef.id;
}
