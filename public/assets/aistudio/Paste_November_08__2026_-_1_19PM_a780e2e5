7.2 Real-Time Intent Ambiguity Heatmap ParserTypeScript// src/components/scoping/ambiguity-parser.ts
export function evaluateDirectiveAmbiguity(text: string): { score: number; warnings: string[] } {
  if (!text.trim()) return { score: 0, warnings: [] };

  const ambiguousTerms = [
    { word: 'secure', suggestion: 'Specify compliance standard (SOC2, FedRAMP, ISO 27001)' },
    { word: 'fast', suggestion: 'Define precise latency bound (e.g., p99 < 50ms)' },
    { word: 'scalable', suggestion: 'Define target throughput requests-per-second (RPS)' },
    { word: 'robust', suggestion: 'Define acceptable failover downtime threshold' }
  ];

  const warnings: string[] = [];
  let penalty = 0;

  ambiguousTerms.forEach(item => {
    if (text.toLowerCase().includes(item.word)) {
      penalty += 18;
      warnings.push(`Ambiguous term "${item.word}": ${item.suggestion}`);
    }
  });

  const score = Math.max(10, 100 - penalty);
  return { score, warnings };
}
