import { MandateASTSchema, MandateAST } from './ast-ir-spec';
import { sanitizeRawLLMResponse } from './token-sanitizer';

export function parseAndValidateCandidateAST(rawLLMOutput: string): MandateAST {
  const sanitizedJsonString = sanitizeRawLLMResponse(rawLLMOutput);
  let parsedObject: unknown;

  try {
    parsedObject = JSON.parse(sanitizedJsonString);
  } catch (err: any) {
    throw new Error(`AST Token Parsing Failure: Ingestion payload is not valid JSON. Raw: ${err.message}`);
  }

  // Zod Structural & Invariant Compilation Check
  const astResult = MandateASTSchema.safeParse(parsedObject);
  if (!astResult.success) {
    const errorIssues = astResult.error.issues
      .map(issue => `[Path: ${issue.path.join('.')} - ${issue.message}]`)
      .join('; ');
    throw new Error(`AST Invariant Validation Violation: ${errorIssues}`);
  }

  return astResult.data;
}
2.4 Directed Acyclic Graph (DAG) DFS Cycle Detection MatrixTypeScript// src/lib/dag-validator.ts
import { MandateAST } from './ast-ir-spec';

export function assertValidAOUDAG(ast: MandateAST): void {
  const graph = new Map<string, string[]>();
  const allNodeIds = new Set<string>();

  for (const unit of ast.units) {
    allNodeIds.add(unit.id);
    graph.set(unit.id, unit.dependsOn);
  }

  // Verification Step 1: Ensure all parent dependencies exist in the graph
  for (const unit of ast.units) {
    for (const parentId of unit.dependsOn) {
      if (!allNodeIds.has(parentId)) {
        throw new Error(
          `DAG Structural Failure: Unit [${unit.id}] references non-existent parent dependency [${parentId}]`
        );
      }
    }
  }

  // Verification Step 2: Depth-First Search for Circular Dependency Cycles
  const visited = new Set<string>();
  const recursionStack = new Set<string>();

  function dfs(nodeId: string): boolean {
    visited.add(nodeId);
    recursionStack.add(nodeId);

    const parentDependencies = graph.get(nodeId) || [];
    for (const parentId of parentDependencies) {
      if (!visited.has(parentId)) {
        if (dfs(parentId)) return true;
      } else if (recursionStack.has(parentId)) {
        return true; // Cycle detected
      }
    }

    recursionStack.delete(nodeId);
    return false;
  }

  for (const unit of ast.units) {
    if (!visited.has(unit.id)) {
      if (dfs(unit.id)) {
        throw new Error(
          `DAG Deadlock Error: Circular execution dependency detected originating at node [${unit.id}]`
        );
      }
    }
  }
}
