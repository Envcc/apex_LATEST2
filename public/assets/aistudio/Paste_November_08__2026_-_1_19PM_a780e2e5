5.2 TLSNotary Web Proofs & HTTP Telemetry AttestationTypeScript// src/lib/telemetry-verifier.ts
import crypto from 'node:crypto';
import { ExitCriterion } from './ast-ir-spec';

export interface AttestationResult {
  criterionId: string;
  verified: boolean;
  actualStatusCode: number;
  computedHash: string;
  timestamp: string;
}

export async function verifyCriterionAttestation(criterion: ExitCriterion): Promise<AttestationResult> {
  const response = await fetch(criterion.assertionEndpoint, { method: 'GET' });
  const textPayload = await response.text();

  // Compute SHA-256 hash digest over payload response
  const computedHash = crypto
    .createHash('sha256')
    .update(textPayload)
    .digest('hex');

  const statusMatches = response.status === criterion.expectedStatusCode;
  const hashMatches = computedHash === criterion.expectedPayloadHash;

  return {
    criterionId: criterion.id,
    verified: statusMatches && hashMatches,
    actualStatusCode: response.status,
    computedHash,
    timestamp: new Date().toISOString()
  };
}
