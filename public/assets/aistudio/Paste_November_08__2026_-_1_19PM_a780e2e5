import { Request, Response, NextFunction } from 'express';
import { adminAuth } from '../../src/lib/firebase-admin';

export interface AuthenticatedRequest extends Request {
  user?: {
    uid: string;
    email?: string;
    role: string;
  };
}

export async function verifyStrictBearerAuth(
  req: AuthenticatedRequest,
  res: Response,
  next: NextFunction
) {
  // Disable development bypass in production environments
  if (process.env.NODE_ENV === 'development' && req.headers['x-dev-sandbox-bypass'] === 'true') {
    req.user = { uid: 'dev-sandbox-admin', email: 'admin@apexbureau.internal', role: 'ADMIN' };
    return next();
  }

  const authHeader = req.headers.authorization;
  if (!authHeader || !authHeader.startsWith('Bearer ')) {
    return res.status(401).json({ error: 'Security Access Violation: Bearer Token Missing' });
  }

  const idToken = authHeader.split('Bearer ')[1];

  try {
    // Mandate checkRevoked = true to reject revoked tokens immediately
    const decodedToken = await adminAuth.verifyIdToken(idToken, true);
    req.user = {
      uid: decodedToken.uid,
      email: decodedToken.email,
      role: (decodedToken.role as string) || 'USER'
    };
    next();
  } catch (error: any) {
    return res.status(401).json({ error: 'Unauthorized: Session Token Invalid or Revoked' });
  }
}
