import { Worker } from 'node:worker_threads';
import path from 'node:path';
import { RiskParams, RiskMatrixResult } from '../src/lib/simulation-engine';

export class MultithreadedSimulationPool {
  private workerPath: string;

  constructor() {
    this.workerPath = path.resolve(__dirname, './sim-worker.js');
  }

  public async runSimulation(params: RiskParams): Promise<RiskMatrixResult> {
    return new Promise((resolve, reject) => {
      const worker = new Worker(this.workerPath, { workerData: params });

      worker.on('message', (response) => {
        worker.terminate();
        if (response.success) {
          resolve(response.data);
        } else {
          reject(new Error(response.error));
        }
      });

      worker.on('error', (err) => {
        worker.terminate();
        reject(err);
      });

      worker.on('exit', (code) => {
        if (code !== 0) {
          reject(new Error(`Worker thread terminated unexpectedly with code ${code}`));
        }
      });
    });
  }
}
