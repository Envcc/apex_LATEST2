      where: { id: payload.milestoneId },
      include: { engagement: { include: { escrows: true } } },
    });

    if (!milestone) throw new Error(`[PoOVerifier] Milestone ${payload.milestoneId} not found.`);
    if (milestone.isCompleted) throw new Error(`[PoOVerifier] Milestone ${payload.milestoneId} is already liquidated.`);

