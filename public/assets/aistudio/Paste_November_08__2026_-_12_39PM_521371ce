// backend/src/services/CostSynthesis.ts
import { PrismaClient, Decimal } from '@prisma/client';
import { MonteCarlo } from './MonteCarlo';
import { RiskModeler } from './RiskModeler';

const prisma = new PrismaClient();

export class CostSynthesis {
  private mc = new MonteCarlo();
  private risk = new RiskModeler();

  async calculateEngagementFee(engagementId: string) {
    const engagement = await prisma.engagement.findUnique({
      where: { id: engagementId },
      include: { aous: true },
    });
    if (!engagement) throw new Error('Engagement not found');

    let directLabor = 0;
    const breakdown: any[] = [];

    for (const aou of engagement.aous) {
      const baseRate = this.getLoadedRate(aou.geographicZone || 'US-WEST', aou.title);
      const alpha = this.getGeoUrgencyFactor(aou.geographicZone || 'US');
      const hours = aou.estimatedHours;
      const labor = hours * baseRate * alpha;
      directLabor += labor;
      breakdown.push({ aouId: aou.aouId, hours, rate: baseRate, alpha, labor });
    }

    const logistics = this.estimateLogistics(engagement.geographicZone || 'US', engagement.aous.length);
    const overhead = directLabor * 0.18;
    const complexity = this.risk.computeComplexityMultiplier(engagement.aous);
    const riskSum = this.risk.computeRiskPremiumSum({
      zone: engagement.geographicZone,
      sovereignty: engagement.dataSovereignty,
      aouCount: engagement.aous.length,
      urgency: false,
    });

    const base = directLabor + logistics + overhead;
    const totalFee = base * (1 + complexity + riskSum);

    const mcResult = await this.mc.run({
      labor: directLabor,
      logistics,
      overhead,
      complexity,
      riskSum,
      runs: 10000,
    });

    const costModel = await prisma.costModel.create({
      data: {
        engagementId,
        directLabor: new Decimal(directLabor.toFixed(2)),
        logistics: new Decimal(logistics.toFixed(2)),
        overhead: new Decimal(overhead.toFixed(2)),
        complexityMult: complexity,
        riskPremiumSum: riskSum,
        totalFee: new Decimal(totalFee.toFixed(2)),
        breakdown,
        monteCarloRuns: 10000,
        var99_99: new Decimal(mcResult.var9999.toFixed(2)),
      },
    });

    await prisma.engagement.update({
      where: { id: engagementId },
      data: {
        totalFee: new Decimal(totalFee.toFixed(2)),
        riskPremium: riskSum,
        complexityMult: complexity,
        status: 'PRICED',
      },
    });

    return { costModel, totalFee, mcResult };
  }

  private getLoadedRate(zone: string, skill: string): number {
    const rates: Record<string, number> = {
      'US-WEST': 285,
      'US-EAST': 265,
      'EU-WEST': 240,
      'APAC': 180,
      'LATAM': 120,
    };
    const skillMult = skill.toLowerCase().includes('audit') || skill.toLowerCase().includes('crypto') ? 1.45 : 1.0;
    return (rates[zone] || 200) * skillMult;
  }

  private getGeoUrgencyFactor(zone: string): number {
    const factors: Record<string, number> = {
      'US-WEST': 1.0,
      'EU-WEST': 1.12,
      'APAC': 1.18,
      'HIGH-RISK': 1.45,
    };
    return factors[zone] || 1.05;
  }

  private estimateLogistics(zone: string, aouCount: number): number {
    const base = zone.startsWith('US') ? 8500 : zone.startsWith('EU') ? 14500 : 22000;
    return base + aouCount * 1200;
  }
}
