// SPDX-License-Identifier: MIT
pragma solidity ^0.8.20;

interface IProofOfOutcomeVerifier {
    function verifyProof(bytes32 milestoneHash, bytes calldata proofData) external view returns (bool);
}

contract OutcomeEscrowVault {
    enum State { Created, Locked, Verifying, Released, Disputed }

    struct Milestone {
        uint256 amount;
        bytes32 poHash;
        bool isCompleted;
    }

    address public client;
    address public bureau;
    IProofOfOutcomeVerifier public verifier;
    uint256 public currentMilestoneIndex;
    Milestone[] public milestones;
    State public currentState;

    event EscrowFunded(uint256 totalAmount);
    event MilestoneVerified(uint256 indexed index, bytes32 poHash);
    event FundsReleased(uint256 indexed index, uint256 amount);
    event Disputed(uint256 indexed index);

    modifier onlyClient() {
        require(msg.sender == client, "Client only");
        _;
    }

    modifier onlyBureau() {
        require(msg.sender == bureau, "Bureau only");
        _;
    }

    constructor(address _client, address _bureau, address _verifier) {
        client = _client;
        bureau = _bureau;
        verifier = IProofOfOutcomeVerifier(_verifier);
        currentState = State.Created;
    }

    function addMilestone(uint256 _amount, bytes32 _poHash) external onlyBureau {
        require(currentState == State.Created, "Already locked");
        milestones.push(Milestone({ amount: _amount, poHash: _poHash, isCompleted: false }));
    }

    function lockEscrow() external payable onlyClient {
        uint256 totalRequired = 0;
        for (uint256 i = 0; i < milestones.length; i++) {
            totalRequired += milestones[i].amount;
        }
        require(msg.value == totalRequired, "Incorrect amount");
        currentState = State.Locked;
        emit EscrowFunded(msg.value);
    }

    function submitProofAndRelease(bytes calldata proofData) external onlyBureau {
        require(currentState == State.Locked || currentState == State.Verifying, "Invalid state");
        require(currentMilestoneIndex < milestones.length, "All complete");
        Milestone storage m = milestones[currentMilestoneIndex];
        require(!m.isCompleted, "Already done");

        bool isValid = verifier.verifyProof(m.poHash, proofData);
        require(isValid, "PoO failed");

        m.isCompleted = true;
        uint256 releaseAmount = m.amount;
        currentMilestoneIndex++;
        if (currentMilestoneIndex == milestones.length) {
            currentState = State.Released;
        }

        (bool ok, ) = payable(bureau).call{value: releaseAmount}("");
        require(ok, "Transfer failed");
        emit MilestoneVerified(currentMilestoneIndex - 1, m.poHash);
        emit FundsReleased(currentMilestoneIndex - 1, releaseAmount);
    }

    function raiseDispute(uint256 index) external onlyClient {
        require(index < milestones.length, "Invalid");
        currentState = State.Disputed;
        emit Disputed(index);
    }
}
