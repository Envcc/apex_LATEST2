// backend/src/services/RiskModeler.ts
export class RiskModeler {
  computeComplexityMultiplier(aous: any[]): number {
    const depth = this.maxDepth(aous);
    const density = aous.reduce((s, a) => s + (a.operationalDeps?.length || 0), 0) / Math.max(aous.length, 1);
    return Math.min(0.05 + depth * 0.04 + density * 0.08, 0.55);
  }

  computeRiskPremiumSum(params: {
    zone?: string | null;
    sovereignty?: string | null;
    aouCount: number;
    urgency?: boolean;
  }): number {
    let sum = 0;
    if (params.zone && !params.zone.startsWith('US') && !params.zone.startsWith('EU')) sum += 0.22;
    if (params.sovereignty?.includes('STRICT') || params.sovereignty?.includes('GDPR')) sum += 0.15;
    if (params.aouCount > 12) sum += 0.12;
    if (params.urgency) sum += 0.35;
    if (params.zone?.includes('HIGH') || params.zone?.includes('SANCTION')) sum += 0.40;
    return Math.min(sum, 1.25);
  }

  private maxDepth(aous: any[]): number {
    const map = new Map(aous.map(a => [a.aouId, a.operationalDeps || []]));
    let max = 0;
    const dfs = (id: string, d: number, seen: Set<string>) => {
      if (seen.has(id)) return;
      seen.add(id);
      max = Math.max(max, d);
      for (const dep of map.get(id) || []) dfs(dep, d + 1, seen);
    };
    aous.forEach(a => dfs(a.aouId, 1, new Set()));
    return max;
  }
}
