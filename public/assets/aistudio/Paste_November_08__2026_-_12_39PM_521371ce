  private wallet = new ethers.Wallet(process.env.DEPLOYER_KEY || '0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80', this.provider);

  async createEscrow(engagementId: string, milestones: { amount: number; poHash: string }[]) {
    const engagement = await prisma.engagement.findUnique({ where: { id: engagementId } });
    if (!engagement) throw new Error('Engagement not found');

    const total = milestones.reduce((s, m) => s + m.amount, 0);
    const escrow = await prisma.escrow.create({
      data: {
        engagementId,
        totalAmount: new Decimal(total),
        state: 'CREATED',
        clientAddress: engagement.clientId,
        bureauAddress: process.env.BUREAU_WALLET,
      },
    });

    for (let i = 0; i < milestones.length; i++) {
      await prisma.milestone.create({
        data: {
          engagementId,
          index: i,
          title: `Phase ${i}`,
          amount: new Decimal(milestones[i].amount),
          poHash: milestones[i].poHash,
          status: 'LOCKED',
        },
      });
    }

    return escrow;
  }

  async lockEscrow(escrowId: string, txHash: string, amount: number) {
    const escrow = await prisma.escrow.update({
      where: { id: escrowId },
      data: {
        state: 'LOCKED',
        txHash,
        totalAmount: new Decimal(amount),
      },
    });
    await prisma.engagement.update({
      where: { id: escrow.engagementId },
      data: { status: 'FUNDED' },
    });
    return escrow;
  }

  async submitProofAndRelease(milestoneId: string, proofData: any, verifierSignature: string) {
    const milestone = await prisma.milestone.findUnique({
      where: { id: milestoneId },
      include: { engagement: { include: { escrows: true } } },
    });
    if (!milestone || milestone.isCompleted) throw new Error('Invalid milestone');

    const valid = await this.verifyPoO(milestone.poHash, proofData);
    if (!valid) throw new Error('PoO verification failed');

    await prisma.milestone.update({
      where: { id: milestoneId },
      data: {
        isCompleted: true,
        verifiedAt: new Date(),
        proofData,
        status: 'RELEASED',
      },
    });

    const escrow = milestone.engagement.escrows[0];
    const newReleased = Number(escrow.releasedAmount) + Number(milestone.amount);
    await prisma.escrow.update({
      where: { id: escrow.id },
      data: {
        releasedAmount: new Decimal(newReleased),
        state: newReleased >= Number(escrow.totalAmount) ? 'RELEASED' : 'LOCKED',
      },
    });

    return { released: milestone.amount, remaining: Number(escrow.totalAmount) - newReleased };
  }

  private async verifyPoO(poHash: string, proofData: any): Promise<boolean> {
    if (proofData.passRatePPM >= 1000000 && proofData.executionTraceRoot && proofData.targetStateHash) {
      return true;
    }
    return false;
  }
}
