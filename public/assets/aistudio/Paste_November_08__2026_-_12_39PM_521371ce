  constraints: {
    geographicZone?: string;
    dataSovereigntyRule?: string;
    hardwarePrerequisites?: string[];
  };
  exitCriteria: Record<string, any>;
  estimatedHours: number;
}

export class ScopingEngine {
  async ingestOutcome(engagementId: string, targetOutcome: string, rawAOUs: AOUInput[]) {
    const aous = rawAOUs.map((a, i) => ({
      aouId: `AOU-${Date.now()}-${i}`,
      parentNode: a.parentNode || null,
      title: a.title,
      operationalDeps: a.operationalDeps || [],
      inputs: a.inputs,
      constraints: a.constraints,
      exitCriteria: a.exitCriteria,
      estimatedHours: a.estimatedHours,
      geographicZone: a.constraints.geographicZone,
      dataSovereigntyRule: a.constraints.dataSovereigntyRule,
      hardwarePrereqs: a.constraints.hardwarePrerequisites || [],
      engagementId,
    }));

    const graph = buildDAG(aous.map(a => ({ id: a.aouId, deps: a.operationalDeps })));
    if (detectCycles(graph)) {
      throw new Error('Cyclic dependency detected in AOU graph. Contract compilation failed.');
    }

    const sorted = topologicalSort(graph);
    const created = await prisma.$transaction(
      aous.map(a => prisma.aOU.create({ data: a }))
    );

    await prisma.engagement.update({
      where: { id: engagementId },
      data: { status: 'SCOPING' },
    });

    return { aous: created, topology: sorted };
  }

  async lockScope(engagementId: string) {
    const engagement = await prisma.engagement.findUnique({
      where: { id: engagementId },
      include: { aous: true },
    });
    if (!engagement || engagement.aous.length === 0) throw new Error('No AOUs defined');
    await prisma.engagement.update({
      where: { id: engagementId },
      data: { status: 'PRICED', lockedAt: new Date() },
