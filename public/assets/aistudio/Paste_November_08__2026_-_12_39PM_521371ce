// backend/src/services/MonteCarlo.ts
export class MonteCarlo {
  async run(params: {
    labor: number;
    logistics: number;
    overhead: number;
    complexity: number;
    riskSum: number;
    runs: number;
  }) {
    const results: number[] = [];
    for (let i = 0; i < params.runs; i++) {
      const laborVar = params.labor * this.pert(0.85, 1.0, 1.35);
      const logVar = params.logistics * this.pert(0.7, 1.0, 1.8);
      const ohVar = params.overhead * this.pert(0.9, 1.0, 1.25);
      const base = laborVar + logVar + ohVar;
      const mult = 1 + params.complexity * this.pert(0.8, 1.0, 1.4) + params.riskSum * this.pert(0.6, 1.0, 1.9);
      results.push(base * mult);
    }
    results.sort((a, b) => a - b);
    const mean = results.reduce((a, b) => a + b, 0) / results.length;
    const p50 = results[Math.floor(params.runs * 0.5)];
    const p90 = results[Math.floor(params.runs * 0.9)];
    const var9999 = results[Math.floor(params.runs * 0.9999)] || results[results.length - 1];
    return { mean, p50, p90, var9999, samples: results.slice(0, 100) };
  }

  private pert(a: number, m: number, b: number): number {
    const mu = (a + 4 * m + b) / 6;
    const sigma = (b - a) / 6;
    let u = 0, v = 0;
    while (u === 0) u = Math.random();
    while (v === 0) v = Math.random();
    const z = Math.sqrt(-2.0 * Math.log(u)) * Math.cos(2.0 * Math.PI * v);
    return Math.max(a, Math.min(b, mu + z * sigma));
  }
}
