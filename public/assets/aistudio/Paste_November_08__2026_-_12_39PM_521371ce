import { api } from '@/lib/api';

export function ScopingEngine({ engagementId }: { engagementId: string }) {
  const [objective, setObjective] = useState('');
  const [zone, setZone] = useState('US-WEST');
  const [aous, setAous] = useState<any[]>([]);
  const [isCompiling, setIsCompiling] = useState(false);
  const [isLocked, setIsLocked] = useState(false);

  const handleCompile = async () => {
    if (!objective.trim()) return;
    setIsCompiling(true);
    try {
      const response = await api.post('/scoping/generate', {
        engagementId,
        objective,
        zone,
      });
      setAous(response.data.aous || []);
    } catch (err: any) {
      alert(`[Scoping Compiler Error]: ${err.response?.data?.message || err.message}`);
    } finally {
      setIsCompiling(false);
    }
  };

  const handleLockScope = async () => {
    try {
      await api.post(`/scoping/${engagementId}/lock`);
      setIsLocked(true);
      alert('Scope successfully compiled and locked. WBS is now immutable.');
    } catch (err: any) {
      alert(`[Lock Failed]: ${err.response?.data?.message || err.message}`);
    }
  };

  return (
    <div className="space-y-6">
      <Card className="border-cyan-500/30">
        <div className="flex justify-between items-center mb-6">
          <div>
            <h3 className="text-xl font-bold text-white">Topological Scoping Engine</h3>
            <p className="text-xs text-slate-400 font-mono mt-1">
              Transforms natural language directives into Directed Acyclic Graphs (DAG) of Atomic Operational Units (AOUs).
            </p>
          </div>
          {isLocked && (
            <span className="px-3 py-1 bg-cyan-500/10 border border-cyan-500/50 text-cyan-400 font-mono text-xs rounded-full">
              IMMUTABLE SCOPE LOCKED
            </span>
          )}
        </div>

        <div className="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
          <div className="md:col-span-2">
            <Input
              label="Target Outcome Specification"
              placeholder="e.g., Deploy air-gapped zero-knowledge validation node in EU-WEST with regulatory clearance"
              value={objective}
              onChange={(e) => setObjective(e.target.value)}
              disabled={isLocked || isCompiling}
            />
          </div>
          <div>
            <label className="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
              Jurisdiction / Zone
            </label>
            <select
              value={zone}
              onChange={(e) => setZone(e.target.value)}
              disabled={isLocked || isCompiling}
              className="w-full bg-slate-950 border border-slate-800 rounded-lg px-4 py-2.5 text-sm text-white focus:outline-none focus:border-cyan-500"
            >
              <option value="US-WEST">US-WEST (California / Oregon)</option>
              <option value="US-EAST">US-EAST (Virginia / NY)</option>
              <option value="EU-WEST">EU-WEST (Frankfurt / Dublin)</option>
              <option value="APAC">APAC (Singapore / Tokyo)</option>
              <option value="HIGH-RISK-ZONE">HIGH-RISK (Special Handling)</option>
            </select>
          </div>
        </div>

